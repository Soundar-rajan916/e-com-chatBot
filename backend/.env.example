APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/ecom_dev
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/ecom_test

# Groq API configuration
GROQ_API_KEY=gsk_placeholder_replace_with_real_key
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Models
ROUTER_MODEL=openai/gpt-oss-20b
GENERATOR_MODEL=openai/gpt-oss-120b

# Reliability
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# Business Rules
REFUND_AUTO_APPROVE_LIMIT_INR=2000
RETURN_WINDOW_DAYS=7

# Pricing (USD per 1M tokens) & Currency Conversion
PRICE_PER_1M_INPUT_TOKENS_USD_ROUTER=0.05
PRICE_PER_1M_OUTPUT_TOKENS_USD_ROUTER=0.08
PRICE_PER_1M_INPUT_TOKENS_USD_GENERATOR=0.59
PRICE_PER_1M_OUTPUT_TOKENS_USD_GENERATOR=0.79
USD_INR_RATE=84.0

# Constraints & Conversation History
MAX_MESSAGE_CHARS=1000
HISTORY_TURNS=6

# CORS
CORS_ORIGINS=http://localhost:5173

# Phase 2 RAG & Vector Configurations
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
VECTOR_BACKEND=numpy
RAG_TOP_K=4
RAG_MIN_SCORE=0.82
PRODUCT_SEARCH_CANDIDATES=20
EMBEDDING_QUERY_PREFIX=query: 
EMBEDDING_PASSAGE_PREFIX=passage: 

# Phase 3 Part A: Admin & Escalations
ADMIN_SESSION_HOURS=8
ESCALATION_SLA_MINUTES=15
ADMIN_COOKIE_NAME=admin_session

# Phase 3 Part B: Budget Governor & Rate Limits
REDIS_URL=redis://localhost:6379/0
MONTHLY_BUDGET_INR=50000
BUDGET_TIMEZONE=Asia/Kolkata
MODE_SAVER_AT_PCT=70
MODE_CRITICAL_AT_PCT=90
MODE_EXHAUSTED_AT_PCT=100
RESERVE_PCT=5
DAILY_PACING_BURST_FACTOR=3.0
CHEAP_GENERATOR_MODEL=openai/gpt-oss-20b
CACHE_TTL_SECONDS=86400
CACHE_ENABLED=true
RATE_LIMIT_PER_CUSTOMER_PER_MIN=12
RATE_LIMIT_PER_IP_PER_MIN=60
GLOBAL_LLM_CONCURRENCY=16
QUEUE_WAIT_MS=2000
TRUSTED_PROXY=false
LLM_MODE=live

# Phase 3 Part C: Voice Notes / Speech-to-Text
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE_HINT=auto
VOICE_MAX_SECONDS=60
VOICE_MAX_BYTES=3000000
VOICE_ALLOWED_MIME=audio/webm,audio/ogg,audio/mp4,audio/mpeg,audio/wav
VOICE_MIN_CONFIDENCE=0.50
VOICE_STORE_AUDIO=false
STT_PRICE_PER_MINUTE_USD=0.006
VOICE_RATE_LIMIT_PER_CUSTOMER_PER_MIN=6
VOICE_AUTO_SEND=false
