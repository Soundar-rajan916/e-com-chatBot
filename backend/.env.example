APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/ecom_dev
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/ecom_test

# Groq API configuration
GROQ_API_KEY=gsk_placeholder_replace_with_real_key
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Models
ROUTER_MODEL=openai/gpt-oss-20b
GENERATOR_MODEL=openai/gpt-oss-120b

# Reliability
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# Business Rules
REFUND_AUTO_APPROVE_LIMIT_INR=2000
RETURN_WINDOW_DAYS=7

# Pricing (USD per 1M tokens) & Currency Conversion
PRICE_PER_1M_INPUT_TOKENS_USD_ROUTER=0.05
PRICE_PER_1M_OUTPUT_TOKENS_USD_ROUTER=0.08
PRICE_PER_1M_INPUT_TOKENS_USD_GENERATOR=0.59
PRICE_PER_1M_OUTPUT_TOKENS_USD_GENERATOR=0.79
USD_INR_RATE=84.0

# Constraints & Conversation History
MAX_MESSAGE_CHARS=1000
HISTORY_TURNS=6

# CORS
CORS_ORIGINS=http://localhost:5173

# Phase 2 RAG & Vector Configurations
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
VECTOR_BACKEND=numpy
RAG_TOP_K=4
RAG_MIN_SCORE=0.82
PRODUCT_SEARCH_CANDIDATES=20
EMBEDDING_QUERY_PREFIX=query: 
EMBEDDING_PASSAGE_PREFIX=passage: 
